{
  "multipart": [
    {
      "apply": {
        "model": "tconstruct:block/casting_channel_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "tconstruct:block/casting_channel_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "tconstruct:block/casting_channel_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "tconstruct:block/casting_channel_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "tconstruct:block/casting_channel_side",
        "y": 270
      }
    }
  ]
}
