            "model": "morebows:item/diamond_bow_pulling_1"
          }
        },
        {
          "threshold": 6,
          "model": {
            "type": "minecraft:model",
            "model": "morebows:item/diamond_bow_pulling_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "morebows:item/diamond_bow_pulling_0"
      }
    }
  }
}
